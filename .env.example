# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 .gitignore 대상입니다.

# ── 없어도 돌아간다. 있으면 좋아지는 것들 ───────────────────────────────
# 네이버 검색 API — developers.naver.com/apps 에서 "검색" 선택. 무료 25,000회/일
# 없으면 Google News RSS로 자동 폴백한다. 단 헤드라인만 얻어서 근거가 얇아지고
# richness가 thin으로 떨어져 글이 짧게 나간다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Anthropic API — console.anthropic.com
# 없으면 에이전트 경로로 간다: run.ps1 --stage crawl / title / finish
# (클로드 코드가 글을 쓰고, 수집·제목 점수·형식 검증은 파이썬이 그대로 한다)
ANTHROPIC_API_KEY=

# ── 사진 소싱 (사실상 필수) ─────────────────────────────────────────────
# Wikimedia/Openverse만으로는 다이어트 소재 사진이 거의 안 나온다(실측 확인).
# 음식·운동 컷은 Pexels/Unsplash가 압도적으로 낫다. 둘 중 하나만 있어도 된다.
#   Pexels   : pexels.com/api          무료, 200req/h
#   Unsplash : unsplash.com/developers 무료, 50req/h (Demo 기준)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Pixabay는 무료 API가 긴 변 1280px 상한이라 정사각 1400 가공에 거의 기여 못 함
PIXABAY_API_KEY=
